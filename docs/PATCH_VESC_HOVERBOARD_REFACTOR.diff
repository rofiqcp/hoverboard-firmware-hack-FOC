-static uint8_t sine_table_index(uint16_t phase) {
-  const uint32_t degree = ((uint32_t)phase * 360u) >> 16;
-  uint32_t index = degree >> 1;
-  if (index > 180u) index = 180u;
-  return (uint8_t)index;
-}

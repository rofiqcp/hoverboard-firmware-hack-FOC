-static void current_clarke_park(motor_all_state_t *motor, uint16_t phase) {
-  const mc_configuration *conf = motor->m_conf;
-  foc_state_t *state = &motor->m_motor_state;
-
-  const int32_t i1 = (int32_t)motor->m_input.current_adc_1 << 4;
-  const int32_t i2 = (int32_t)motor->m_input.current_adc_2 << 4;
-  int32_t i_alpha;
-  int32_t i_beta;
-
-  if (conf->foc_current_sample_map == 0u) {
-    i_alpha = i1;
-    i_beta = ((FOC_ONE_BY_SQRT3_Q15 * i1) >> 15) +
-             ((FOC_ONE_BY_SQRT3_Q15 * i2) >> 14);
-  } else {
-    i_alpha = -i1 - i2;
-    i_beta = (FOC_ONE_BY_SQRT3_Q15 * (i1 - i2)) >> 15;
-  }
-
-  i_alpha = clamp_s16(i_alpha);
-  i_beta = clamp_s16(i_beta);
-
-  const int32_t s = sin_q15(phase);
-  const int32_t c = sin_q15((uint16_t)(phase + 16384u));
-  const int16_t iq_raw = clamp_s16((i_beta * c - i_alpha * s) >> 15);
-  const int16_t id_raw = clamp_s16((i_alpha * c + i_beta * s) >> 15);
-
-  state->iq = lowpass_q4(iq_raw, conf->foc_current_filter_const, &state->iq_filter_state);
-  state->id = lowpass_q4(id_raw, conf->foc_current_filter_const, &state->id_filter_state);

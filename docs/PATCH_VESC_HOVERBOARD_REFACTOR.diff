+void mc_interface_set_current(float current) {
+  const mc_configuration *conf = selected_side() == 1u ? &m_mcconf_1 : &m_mcconf_2;
+  const float max_current = (float)conf->l_current_max / ((float)A2BIT_CONV * 16.0f);

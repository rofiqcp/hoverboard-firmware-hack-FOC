-void advanced_control_reset(void) {
-  pid_state_reset(&m_speed_pid_left);
-  pid_state_reset(&m_speed_pid_right);
-  pid_state_reset(&m_position_pid);
-  m_position_speed_set = 0;
-}
-
-void advanced_control_update(uint8_t requested_mode, int16_t command_left, int16_t command_right,
-                           int16_t rpm_left, int16_t rpm_right,
-                           int16_t *motor_target_left, int16_t *motor_target_right,
-                           uint8_t *control_mode_left, uint8_t *control_mode_right) {
-  *motor_target_left = command_left;
-  *motor_target_right = -command_right; /* Right motor is physically mirrored; host-positive remains forward. */
-  uint8_t inner_control_mode = requested_mode;
-  if (requested_mode == COMMUTATION_MODE || requested_mode == SINE_MODE) inner_control_mode = VLT_MODE;
-  if (requested_mode == SVPWM_MODE || requested_mode == OPEN_MODE) inner_control_mode = OPEN_MODE;
-  *control_mode_left = inner_control_mode;
-  *control_mode_right = inner_control_mode;
-
-  if (requested_mode == SPD_MODE) {
-    /* Maximum speed remains stored in the existing EEPROM-compatible rpm x16
-     * representation. Use the live RAM value so GUI tuning takes effect immediately. */
-    int16_t max_rpm_left = (int16_t)(m_mcconf_1.l_max_rpm >> 4);
-    int16_t max_rpm_right = (int16_t)(m_mcconf_2.l_max_rpm >> 4);
-    if (max_rpm_left < 1) max_rpm_left = 1;
-    if (max_rpm_right < 1) max_rpm_right = 1;
-    const int16_t speed_ref_left = (int16_t)(((int32_t)command_left * max_rpm_left) / 1000);
-    const int16_t speed_ref_right = (int16_t)(((int32_t)command_right * max_rpm_right) / 1000);
-    /* A true zero host command is a release request, not a zero-speed hold.
-     * Reset the outer-loop integrator at the end of the existing ramp-down so
-     * stale I-term cannot keep producing q-axis torque after STOP. */
-    if (command_left == 0) {
-      pid_state_reset(&m_speed_pid_left);
-      *motor_target_left = 0;
-    } else {
-      *motor_target_left = pid_step(&m_speed_pid_left, (int16_t)(speed_ref_left - rpm_left),
-                                    s_pid_kp_left_x1000, s_pid_ki_left_x1000, s_pid_kd_left_x1000,
-                                    s_pid_i_limit, s_pid_output_limit, s_pid_d_filter_x1000);
-    }
-
-    if (command_right == 0) {
-      pid_state_reset(&m_speed_pid_right);
-      *motor_target_right = 0;
-    } else {
-      const int16_t right_torque_host = pid_step(&m_speed_pid_right,
-                                                  (int16_t)(speed_ref_right - rpm_right),
-                                                  s_pid_kp_right_x1000, s_pid_ki_right_x1000, s_pid_kd_right_x1000,
-                                                  s_pid_i_limit, s_pid_output_limit, s_pid_d_filter_x1000);
-      *motor_target_right = (int16_t)-right_torque_host;
-    }
-    *control_mode_left = TRQ_MODE;
-    *control_mode_right = TRQ_MODE;
-  }
-#ifdef HW_PROFILE_ENC_HALL
-  else if (requested_mode == POSITION_MODE) {
-    int32_t target = p_pid_set_counts;
-    if (target < p_pid_min_counts) target = p_pid_min_counts;
-    if (target > p_pid_max_counts) target = p_pid_max_counts;
-    int32_t e32 = target - m_encoder_position;
-    if (e32 > 32767) e32 = 32767;
-    if (e32 < -32768) e32 = -32768;
-    int16_t err = (int16_t)e32;
-    if (abs(err) <= p_pid_deadband_counts) err = 0;
-    int16_t position_output_limit = p_pid_speed_limit_rpm;
-    if (m_encoder_sync_state == 4u && m_encoder_return_rpm > 0 && m_encoder_return_rpm < position_output_limit) position_output_limit = m_encoder_return_rpm;
-    m_position_speed_set = pid_step(&m_position_pid, err, p_pid_kp_x1000, p_pid_ki_x1000,
-                                             p_pid_kd_x1000, p_pid_i_limit_rpm,
-                                             position_output_limit, s_pid_d_filter_x1000);
-    *motor_target_left = pid_step(&m_speed_pid_left, (int16_t)(m_position_speed_set - rpm_left),
-                            s_pid_kp_left_x1000, s_pid_ki_left_x1000, s_pid_kd_left_x1000,
-                            s_pid_i_limit, s_pid_output_limit, s_pid_d_filter_x1000);
-    *control_mode_left = TRQ_MODE;
-    /* Position mode is Left-only. Keep Right commanded zero. */
-    *motor_target_right = 0;
-    *control_mode_right = TRQ_MODE;
-  }
-#endif
-  else {
-    advanced_control_reset();
-  }
-}

+    state->iq_target = 0;
+    state->id_target = 0;
+    state->vq = clamp_s16_range(vq, -FOC_VOLTAGE_MAX_RAW, FOC_VOLTAGE_MAX_RAW);
+    state->vd = 0;
+    pi_reset(&motor->m_iq_pi);
+    pi_reset(&motor->m_id_pi);

+static void control_foc(motor_all_state_t *motor, uint16_t phase) {
+  mc_configuration *conf = motor->m_conf;
+  foc_state_t *state = &motor->m_motor_state;
+  const int16_t setpoint = motor->m_input.control_setpoint;
